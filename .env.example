# Copy locally to .env; this file contains no usable credentials.
# Generate each independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-generated-secret-at-least-32-characters
DATABASE_PASSWORD=replace-with-another-generated-secret
# Production override only:
APP_ALLOWED_HOSTS=app.example.com
APP_CSRF_ORIGINS=https://app.example.com

APP_PORT=8000
